{
  "name": "posty-cli",
  "version": "1.0.0",
  "description": "Posty CLI - command line interface for the Posty social media scheduling API. The package is `posty-cli`; the command it installs is `posty`. The bare name `posty` on the registry belongs to an unrelated package.",
  "main": "dist/index.js",
  "bin": {
    "posty": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node ./dist/index.js",
    "prepublishOnly": "pnpm run build",
    "release:check": "tsup && npm pack --dry-run && npm publish --dry-run"
  },
  "files": [
    "dist",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "posty",
    "cli",
    "social-media",
    "scheduling",
    "automation",
    "ai-agent",
    "command-line",
    "x",
    "twitter",
    "facebook",
    "instagram",
    "threads",
    "bluesky",
    "youtube",
    "linkedin",
    "tiktok"
  ],
  "author": "Norbert Kiss",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/norbertlevente/posty-agent.git"
  },
  "homepage": "https://github.com/norbertlevente/posty-agent#readme",
  "bugs": {
    "url": "https://github.com/norbertlevente/posty-agent/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/yargs": "^17.0.32",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
